{
  "name": "javis-macos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "build:js": "node scripts/build-js.mjs",
    "build:native": "node scripts/build-native.mjs",
    "build": "npm run build:js && npm run build:native && node scripts/package-macos.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=2",
    "install:local": "node scripts/install-local.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
