{
  "compilerOptions": {
    "target": "ES2024", "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx", "strict": true,
    "noEmit": true, "skipLibCheck": true, "resolveJsonModule": true, "allowImportingTsExtensions": true,
    "types": ["vite/client", "node"],
    "paths": { "@/*": ["../source/renderer/src/*"], "@renderer/*": ["../source/renderer/src/*"] }
  },
  "include": ["*.ts", "*.tsx", "../source/preload/api-types.ts", "../source/renderer/src/env.d.ts"]
}
